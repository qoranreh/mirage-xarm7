diff --git a/robosuite/models/assets/grippers/xarm_gripper.xml b/robosuite/models/assets/grippers/xarm_gripper.xml
new file mode 100644
index 0000000..911b3c2
--- /dev/null
+++ b/robosuite/models/assets/grippers/xarm_gripper.xml
@@ -0,0 +1,113 @@
+<mujoco model="xarm_gripper">
+    <!-- UFACTORY xArm Gripper. Kinematics/inertials/meshes from MuJoCo Menagerie (ufactory_xarm7/hand.xml),
+         re-written with explicit attributes and robosuite conventions (eef body + grip sites, named finger/pad
+         collision geoms, force/torque sensors). One tendon-driven actuator: ctrl 0 = open, 255 = closed.
+         The eef body is rotated -90 deg about z so that the fingers close along the grip_site x axis, matching
+         PandaGripper and Robotiq85Gripper (the transfer pipeline tracks grip_site poses across robots). -->
+    <asset>
+        <material name="xarmg_white" specular="0.5" shininess="0.25" rgba="1 1 1 1"/>
+        <material name="xarmg_black" specular="0.5" shininess="0.25" rgba="0.149 0.149 0.149 1"/>
+        <mesh name="xarmg_base_link" file="meshes/xarm_gripper/base_link.stl"/>
+        <mesh name="xarmg_left_outer_knuckle" file="meshes/xarm_gripper/left_outer_knuckle.stl"/>
+        <mesh name="xarmg_left_finger" file="meshes/xarm_gripper/left_finger.stl"/>
+        <mesh name="xarmg_left_inner_knuckle" file="meshes/xarm_gripper/left_inner_knuckle.stl"/>
+        <mesh name="xarmg_right_outer_knuckle" file="meshes/xarm_gripper/right_outer_knuckle.stl"/>
+        <mesh name="xarmg_right_finger" file="meshes/xarm_gripper/right_finger.stl"/>
+        <mesh name="xarmg_right_inner_knuckle" file="meshes/xarm_gripper/right_inner_knuckle.stl"/>
+    </asset>
+
+    <tendon>
+        <fixed name="split">
+            <joint joint="right_driver_joint" coef="0.5"/>
+            <joint joint="left_driver_joint" coef="0.5"/>
+        </fixed>
+    </tendon>
+
+    <equality>
+        <connect anchor="0 0.015 0.015" body1="right_finger" body2="right_inner_knuckle" solref="0.005 1"/>
+        <connect anchor="0 -0.015 0.015" body1="left_finger" body2="left_inner_knuckle" solref="0.005 1"/>
+        <joint joint1="left_driver_joint" joint2="right_driver_joint" polycoef="0 1 0 0 0" solref="0.005 1"/>
+    </equality>
+
+    <contact>
+        <exclude body1="right_inner_knuckle" body2="right_outer_knuckle"/>
+        <exclude body1="right_inner_knuckle" body2="right_finger"/>
+        <exclude body1="left_inner_knuckle" body2="left_outer_knuckle"/>
+        <exclude body1="left_inner_knuckle" body2="left_finger"/>
+        <exclude body1="left_inner_knuckle" body2="xarm_gripper_base_link"/>
+        <exclude body1="right_inner_knuckle" body2="xarm_gripper_base_link"/>
+        <exclude body1="left_outer_knuckle" body2="xarm_gripper_base_link"/>
+        <exclude body1="right_outer_knuckle" body2="xarm_gripper_base_link"/>
+    </contact>
+
+    <actuator>
+        <!-- Menagerie: general biastype=affine gainprm=0.333 biasprm="0 -100 -10" ctrlrange="0 255" -> position servo on the split tendon -->
+        <general name="fingers_actuator" tendon="split" biastype="affine" gainprm="0.333 0 0" biasprm="0 -100 -10"
+                 ctrllimited="true" ctrlrange="0 255" forcelimited="true" forcerange="-50 50"/>
+    </actuator>
+
+    <worldbody>
+        <body name="xarm_gripper_base_link" pos="0 0 0">
+            <site name="ft_frame" pos="0 0 0" size="0.01 0.01 0.01" rgba="1 0 0 1" type="sphere" group="1"/>
+            <!-- grip frame at the finger-pad center; fingers (at +-y of this body) close along eef x -->
